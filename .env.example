# --- DATABASE CONFIG ---
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# --- SECURITY ---
SECRET_KEY=your_super_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
APP_ENV=development

# --- INITIAL ADMIN (required by create_admin.py on non-interactive deploy) ---
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password_at_least_12_chars
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PHONE=your_admin_phone

# --- MAIL (GMAIL SMTP / RESEND) ---
RESEND_API_KEY=your_resend_api_key
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com

# --- MOMO SANDBOX ---
MOMO_PARTNER_CODE_SANDBOX=your_momo_partner_code
MOMO_ACCESS_KEY_SANDBOX=your_momo_access_key
MOMO_SECRET_KEY_SANDBOX=your_momo_secret_key
MOMO_API_ENDPOINT_SANDBOX=https://test-payment.momo.vn/v2/gateway/api/create

# --- CALLBACK URLs ---
YOUR_IPN_URL=https://yourdomain.com/api/admin/payment-webhook
YOUR_REDIRECT_URL=https://yourdomain.com/payment-success
YOUR_BASE_DOMAIN=https://yourdomain.com

# --- SEPAY ---
SEPAY_API_KEY=your_sepay_api_key

# --- VIETQR ACCOUNT ---
VIETQR_BANK_ID=your_bank_id
VIETQR_ACCOUNT_NO=your_bank_account_number
VIETQR_ACCOUNT_NAME=your_bank_account_name

# --- UPLOAD ---
MAX_UPLOAD_SIZE_MB=5

# --- GEMINI (optional until the AI phase) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
# Optional public URL used in automated care/review email links.
PUBLIC_SITE_URL=https://binspa.id.vn
ATTENDANCE_ENABLED=false
ATTENDANCE_SIMPLE_MODE=false
ATTENDANCE_BRANCH_ID=0
PAYROLL_V2_ENABLED=false
EMPLOYEE_PORTAL_ENABLED=false
BUSINESS_PORTAL_ENABLED=false
# Lịch hẹn và khách hàng trên giao diện quản trị mới; ?ui=legacy mở lại bản cũ.
ADMIN_BOOKING_REACT_ENABLED=false
# Hóa đơn và bán gói trên giao diện quản trị mới.
ADMIN_BILLING_REACT_ENABLED=false
# Dịch vụ, gói và liệu trình khách trên giao diện quản trị mới.
ADMIN_CATALOG_REACT_ENABLED=false
# Nhân sự, ca làm và lịch cá nhân trên giao diện quản trị mới.
ADMIN_PEOPLE_REACT_ENABLED=false
# Điểm thưởng, đánh giá, tin nhắn và tổng quan đầy đủ trong khung quản trị chung.
ADMIN_CARE_REACT_ENABLED=false
CUSTOMER_BOOKING_REACT_ENABLED=false
CRM_ENABLED=false
CUSTOMER_CONSENT_ENABLED=false
PERSONALIZATION_ENABLED=true
RECOMMENDATION_METRICS_ENABLED=false
BI_REPORTS_ENABLED=false
OBSERVABILITY_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=false
AI_CHAT_JOBS_ENABLED=false
# Set only to the actual number of trusted reverse proxies; leave 0 for direct local access.
TRUSTED_PROXY_HOPS=0
PAYROLL_V2_CUTOVER_DATE=
STAFF_SECURITY_ENABLED=false
# Generate once with Fernet.generate_key(); preserve separately from DB backups.
STAFF_MFA_ENCRYPTION_KEY=
