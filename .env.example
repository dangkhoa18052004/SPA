# --- DATABASE CONFIG ---
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# --- SECURITY ---
SECRET_KEY=your_super_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- MAIL (GMAIL SMTP / RESEND) ---
RESEND_API_KEY=your_resend_api_key
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com

# --- MOMO SANDBOX ---
MOMO_PARTNER_CODE_SANDBOX=your_momo_partner_code
MOMO_ACCESS_KEY_SANDBOX=your_momo_access_key
MOMO_SECRET_KEY_SANDBOX=your_momo_secret_key
MOMO_API_ENDPOINT_SANDBOX=https://test-payment.momo.vn/v2/gateway/api/create

# --- CALLBACK URLs ---
YOUR_IPN_URL=https://yourdomain.com/api/admin/payment-webhook
YOUR_REDIRECT_URL=https://yourdomain.com/payment-success
YOUR_BASE_DOMAIN=https://yourdomain.com

# --- SEPAY ---
SEPAY_API_KEY=your_sepay_api_key
